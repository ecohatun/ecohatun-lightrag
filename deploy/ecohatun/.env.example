# Ecohatun LightRAG - Configuracion de ejemplo
# No colocar claves reales en GitHub.

# Modelos
LLM_MODEL=deepseek-chat
EMBEDDING_MODEL=MintplexLabs/multilingual-e5-small

# Autenticacion del servicio E5
EMBEDDING_BINDING_API_KEY=REEMPLAZAR_CON_CLAVE_E5

# Archivos secretos del servidor donde se ejecuta Docker Compose
DEEPSEEK_KEY_FILE=/RUTA_SEGURA/deepseek_api_key
PROXY_TOKEN_FILE_HOST=/RUTA_SEGURA/proxy_access_token

# Limites conservadores para pruebas
PROXY_MAX_REQUESTS=2
PROXY_MAX_BODY=20480
PROXY_MAX_OUTPUT_TOKENS=512

# Recursos Docker externos: deben existir antes del despliegue
E5_VOLUME_NAME=ecohatun-e5-models-staging
RAG_INTERNAL_NETWORK=ecohatun-e5-staging-net
PROXY_EGRESS_NETWORK=ecohatun-ocr-proxy-egress

# Clave de acceso a la API LightRAG, minimo 32 caracteres aleatorios
LIGHTRAG_API_KEY=REEMPLAZAR_CON_CLAVE_SEGURA
