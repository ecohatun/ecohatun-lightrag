# Ecohatun LightRAG - configuracion de ejemplo

LLM_MODEL=deepseek-chat
LLM_BINDING_HOST=http://proxy-deepseek:8769/v1

# Token interno del proxy. Configurar en Dokploy.
LLM_BINDING_API_KEY=REEMPLAZAR_TOKEN_INTERNO

EMBEDDING_MODEL=MintplexLabs/multilingual-e5-small
EMBEDDING_BINDING_HOST=http://embeddings-e5:8080/v1
EMBEDDING_BINDING_API_KEY=REEMPLAZAR_CLAVE_E5

# La clave oficial de DeepSeek se entrega mediante un
# archivo secreto externo, nunca mediante GitHub.
DEEPSEEK_SECRET_FILE=/run/secrets/deepseek_api_key
